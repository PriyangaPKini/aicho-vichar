---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogListItem from '../components/blog/BlogListItem.astro';
import { HOME_LATEST_BLOG_LIMIT } from '../constants';
import { getLatestBlogPosts } from '../lib/content';

const posts = await getLatestBlogPosts(HOME_LATEST_BLOG_LIMIT);
---

<BaseLayout>
  <figure class="cover">
    <img src="/gallery/holiday-in-munnar.jpeg" alt="" />
  </figure>

  <section class="intro intro-large">
    <h1 class="page-title home-title">Hey, I'm <em class="title-accent">Priyanga P Kini</em></h1>
    <p>A place for reflections on work, life, and what I’m learning along the way.</p>
    <p><em><a href="/about" class="text-link">More about me</a></em></p>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="section-title">
        <span>Latest Blogs</span>
      </div>
      <ul class="post-list">
        {posts.map((post, i) => (
          <BlogListItem post={post} index={i} />
        ))}
      </ul>
      <p class="section-more">
        <a href="/blog">View all &rarr;</a>
      </p>
    </section>
  )}
</BaseLayout>

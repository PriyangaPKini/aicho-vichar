---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/post/PostListItem.astro';
import { HOME_LATEST_POST_LIMIT } from '../constants';
import { getLatestPosts } from '../lib/content';

const posts = await getLatestPosts(HOME_LATEST_POST_LIMIT);
---

<BaseLayout>
  <figure class="cover">
    <img src="/gallery/holiday-in-munnar.jpeg" alt="" />
  </figure>

  <section class="intro intro-large">
    <h1 class="page-title home-title">Hey, I'm <em class="title-accent">Priyanga P Kini</em></h1>
    <p>I use this space to share reflections on work, life, and what I’m learning along the way.</p>
    <p><em><a href="/about" class="text-link">More about me</a></em></p>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <h2 class="section-title">Recent writing</h2>
      <ul class="post-list">
        {posts.map((post, i) => (
          <PostListItem post={post} index={i} />
        ))}
      </ul>
      <p class="section-more">
        <a href="/posts">Full archive &rarr;</a>
      </p>
    </section>
  )}
</BaseLayout>

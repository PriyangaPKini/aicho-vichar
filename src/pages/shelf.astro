---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/search/Search.astro';
import ShelfListItem from '../components/shelf/ShelfListItem.astro';
import { getSortedCollection } from '../lib/content';
import { shelfToSearchItem } from '../lib/search';
import { previewDescription } from '../lib/preview';

const shelf = await getSortedCollection('shelf');
const searchItems = shelf.map(shelfToSearchItem);

// The page opens with this line and the preview reads from the same string.
const intro = 'Books, talks, articles, and podcasts I keep coming back to.';
---

<BaseLayout title="Shelf" description={previewDescription(intro)}>
  <section class="intro intro-listing">
    <h1 class="page-title">The <span class="title-accent">shelf.</span></h1>
    <p>{intro}</p>
  </section>

  <Search
    items={searchItems}
    label="Shelf"
    placeholder="Search shelf..."
    triggerText="Search shelf…"
  />

  <ul class="post-list">
    {shelf.map((item) => (
      <ShelfListItem item={item} />
    ))}
  </ul>
</BaseLayout>


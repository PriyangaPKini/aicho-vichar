---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/post/PostListItem.astro';
import Search from '../../components/search/Search.astro';
import { getSortedCollection } from '../../lib/content';

const posts = await getSortedCollection('posts');
---

<BaseLayout title="The archive">
  <section class="intro intro-listing">
    <h1 class="page-title">The <span class="title-accent">archive.</span></h1>
  </section>

  <Search />
  {posts.length === 0 ? (
    <p style="color: var(--text-muted);">No posts yet. Stay tuned.</p>
  ) : (
    <>
    <h2 class="section-title">
      All writing
      <span class="section-count">{posts.length} {posts.length === 1 ? 'piece' : 'pieces'}</span>
    </h2>
    <ul class="post-list">
      {posts.map((post, i) => (
        <PostListItem post={post} index={i} variant="detailed" />
      ))}
    </ul>
    </>
  )}
</BaseLayout>


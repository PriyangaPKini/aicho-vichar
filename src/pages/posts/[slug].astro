---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CanonicalCallout from '../../components/post/CanonicalCallout.astro';
import PostHeader from '../../components/post/PostHeader.astro';
import PostNavigation from '../../components/post/PostNavigation.astro';
import PostShare from '../../components/post/PostShare.astro';
import { render } from 'astro:content';
import { getSortedCollection } from '../../lib/content';
import { postPreviewDescription } from '../../lib/preview';
import { postThumbnail } from '../../lib/thumbnail';

export async function getStaticPaths() {
  const posts = await getSortedCollection('posts');

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: index < posts.length - 1 ? posts[index + 1] : null,
      next: index > 0 ? posts[index - 1] : null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const postUrl = new URL(`/posts/${post.id}/`, Astro.site).toString();
const thumbnail = postThumbnail(post.id);
const description = postPreviewDescription(post);
---

<BaseLayout title={post.data.title} description={description} image={thumbnail}>
  <PostHeader
    title={post.data.title}
    date={post.data.date}
  />

  <article class="prose">
    <Content />
    <CanonicalCallout url={post.data.canonicalUrl} />
  </article>

  <PostShare slug={post.id} />

  <PostNavigation prev={prev} next={next} />
</BaseLayout>

<style is:global>
  .main-inner {
    padding: 6rem 2rem 1.5rem;
  }
</style>

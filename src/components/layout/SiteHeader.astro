---
import { SITE_TITLE } from '../../constants';
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-header-brand" aria-label={`${SITE_TITLE} home`}>
      {SITE_TITLE}
    </a>
    <nav class="site-header-nav" aria-label="Primary navigation">
      <a href="/about" class="site-header-link">About</a>
      <a href="/posts" class="site-header-link">Archive</a>
      <a href="/shelf" class="site-header-link">Shelf</a>
      <a href="/rss.xml" class="site-header-link site-header-icon-link" title="RSS feed" aria-label="RSS feed">
        <svg width="18" height="18" aria-hidden="true">
          <use href="#icon-rss" />
        </svg>
      </a>
    </nav>
  </div>
</header>

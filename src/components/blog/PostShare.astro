---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const commentsUrl = `https://priyangapkini.substack.com/p/${slug}/comments`;
const subscribeUrl = 'https://priyangapkini.substack.com/subscribe';
---

<section class="post-share" aria-label="Share and subscribe">
  <p class="post-share-prompt">If you enjoyed this, let's keep in touch.</p>
  <div class="post-share-actions">
    <a class="post-share-btn post-share-btn--secondary" href={commentsUrl} target="_blank" rel="noopener noreferrer">
      Start a conversation
    </a>
    <a class="post-share-btn post-share-btn--primary" href={subscribeUrl} target="_blank" rel="noopener noreferrer">
      Subscribe on Substack
    </a>
  </div>
</section>

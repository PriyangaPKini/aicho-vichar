---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const hackerNewsUrl = new URL('https://news.ycombinator.com/submitlink');
hackerNewsUrl.searchParams.set('u', url);
hackerNewsUrl.searchParams.set('t', title);
---

<section class="post-share" aria-label="Share and subscribe">
  <p>If you find this helpful and interesting,</p>
  <ul>
    <li>share it on <a href={hackerNewsUrl.toString()} target="_blank" rel="noopener noreferrer">HackerNews</a></li>
    <li>subscribe to my <a href="/rss.xml">RSS feed</a> and get notified the moment I publish a new one.</li>
  </ul>
</section>

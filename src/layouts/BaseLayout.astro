---
import Icons from '../components/ui/Icons.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import { SITE_DESCRIPTION, SITE_IMAGE, SITE_TITLE } from '../constants';
import '../styles/global.css';

const {
  title,
  description = SITE_DESCRIPTION,
  image = SITE_IMAGE,
} = Astro.props;
// Pages pass their own name only; the site name is appended here so no page repeats it.
const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, Astro.site).toString();
const shareImageUrl = new URL(image, Astro.site).toString();
const plausibleScriptUrl = import.meta.env.PUBLIC_PLAUSIBLE_SCRIPT_URL;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={shareImageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={shareImageUrl} />
  <link rel="icon" type="image/jpeg" href="/avatar.jpg" />
  <title>{pageTitle}</title>
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS Feed`} href="/rss.xml" />
  {plausibleScriptUrl && (
    <>
      <!-- Privacy-friendly analytics by Plausible -->
      <script async src={plausibleScriptUrl}></script>
      <script is:inline>
        window.plausible = window.plausible || function () {
          (plausible.q = plausible.q || []).push(arguments);
        };
        plausible.init = plausible.init || function (options) {
          plausible.o = options || {};
        };
        plausible.init();
      </script>
    </>
  )}
</head>
<body>
  <Icons />
  <div class="flash-notice" data-flash-notice hidden></div>
  <SiteHeader />
  <main class="main">
    <div class="main-inner">
      <slot />
    </div>
  </main>
  <SiteFooter />
  <script>
    const flash = document.querySelector<HTMLElement>('[data-flash-notice]');
    let flashTimer: number | undefined;

    window.addEventListener('site:notice', (event) => {
      if (!flash) return;
      const message = (event as CustomEvent<string>).detail || 'Done.';
      flash.textContent = message;
      flash.hidden = false;
      window.clearTimeout(flashTimer);
      flashTimer = window.setTimeout(() => {
        flash.hidden = true;
      }, 3000);
    });
  </script>
</body>
</html>
